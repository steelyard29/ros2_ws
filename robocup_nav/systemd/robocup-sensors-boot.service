[Unit]
Description=RoboCup stationary ground boot sensors, VIO, map and A-star/APF candidates
Requires=docker.service
Wants=network-online.target time-sync.target
After=docker.service network-online.target time-sync.target
ConditionPathExists=/home/cfly/ros2_ws/robocup_nav/scripts/boot_sensor_stack.sh

[Service]
Type=oneshot
User=cfly
WorkingDirectory=/home/cfly/ros2_ws/robocup_nav
ExecStart=/bin/bash /home/cfly/ros2_ws/robocup_nav/scripts/boot_sensor_stack.sh
TimeoutStartSec=100
RemainAfterExit=yes
Restart=no

[Install]
WantedBy=multi-user.target
