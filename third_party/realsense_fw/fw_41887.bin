<!-- End of HubSpot Embed Code --><style class="wpcode-css-snippet">.side-bar a{
	text-decoration: none;
}

/* Reset lists */
.side-bar ul,
.side-bar li {
  list-style: none;
  margin: 0;
  padding: 0;
}

/* Base menu */
.side-bar .nav {
  display: flex;
  flex-direction: column;
  gap: 2px;
	padding-left: 10px;
}

/* All menu items same level */
@media (min-width: 768px) {
.side-bar .menu-item {
  position: relative;
}
}

/* Links */
.side-bar .menu-item > a {
  display: block;
  padding: 8px 12px;
  color: #222;
  text-decoration: none;
  font-size: 14px;
  line-height: 1.4;
  border-radius: 4px;
  transition: background 0.15s ease, color 0.15s ease;
}

.side-bar .menu-item > a:hover {
  background: #f3f4f6;
  color: #000;
}

/* Current page highlight */
.side-bar .current-menu-item > a,
.side-bar .current-page-ancestor > a {
  font-weight: 600;
  background: #e5e7eb;
}

/* Flatten sub-menus */
.side-bar .sub-menu {
  margin: 0;
  padding: 0;
}

/* Optional subtle divider between logical groups */
.side-bar .menu-item-has-children > a {
  margin-top: 6px;
}

/* External link arrow */
.side-bar a[target="_blank"] {
  position: relative;    /* needed for the arrow positioning */
  padding-right: 28px;
}

.side-bar a[target="_blank"]::after {
  content: "↗";
  position: absolute;
  right: 10px;
  top: 10px;              /* move arrow to top */
  transform: none;       /* remove vertical centering */
  font-size: 12px;
  opacity: 0.6;
}

/* Hover arrow emphasis */
.side-bar a[target="_blank"]:hover::after {
  opacity: 1;
}

/* Child items: slightly smaller + subtle indent */
.side-bar .sub-menu .menu-item > a {
  font-size: 13px;
  padding-left: 22px;
  opacity: 0.9;
}

/* Optional: even deeper levels get a bit more indent */
.side-bar .sub-menu .sub-menu .menu-item > a {
  padding-left: 32px;
  font-size: 12.5px;
}

/* Top-level parents only (not secondary parents) */
.side-bar .nav > .menu-item-has-children > a {
  pointer-events: none;
  cursor: default;
  font-weight: 600;
  color: #111;
}

/* Keep hover from looking clickable */
.side-bar .nav > .menu-item-has-children > a:hover {
  background: transparent;
}

/* Sidebar container scroll */
@media (max-width: 768px) {
	.side-bar {
  max-height: calc(100vh - 120px); /* adjust offset if you have a header */
  overflow-y: auto;
  overflow-x: hidden;
}

	.side-bar {
  max-height: 400px; /* adjust offset if you have a header */
  overflow-y: auto;
  overflow-x: hidden;
}
	
}

/* Smooth scroll on trackpads */
.side-bar {
  scroll-behavior: smooth;
}

/* Optional: nicer scrollbar (WebKit) */
.side-bar::-webkit-scrollbar {
  width: 8px;
}

.side-bar::-webkit-scrollbar-track {
  background: transparent;
}

.side-bar::-webkit-scrollbar-thumb {
  background-color: rgba(0, 0, 0, 0.25);
  border-radius: 4px;
}

.side-bar .nav > .menu-item-has-children > a {
  position: sticky;
  top: 0;
  background: #fff;
  z-index: 1;
}

/* Prevent horizontal scrolling */
html, body {
  overflow-x: hidden;
  max-width: 100%;
}

/* Images & media */
img, video, iframe {
  max-width: 100%;
  height: auto;
}

/* WordPress blocks */
.wp-block-group,
.wp-block-columns,
.wp-block-column {
  max-width: 100%;
}

/* Tables & code blocks */
table {
  display: block;
  overflow-x: auto;
  width: 100%;
}

pre, code {
  white-space: pre-wrap;
  word-break: break-word;
}

